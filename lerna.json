{
  "packages": [
    "packages/*"
  ],
  "npmClient": "yarn",
  "command": {
    "publish": {
      "allowBranch": ["master"],
      "excludeDependents": true,
      "ignoreChanges": ["ignored-file", "*.md"],
      "message": "chore(release) [skip ci]",
      "yes": true
    },
    "version": {
      "allowBranch": "master",
      "conventionalCommits": true,
      "createRelease": "github",
      "excludeDependents": true,
      "yes": true,
      "message": "chore(release) [skip ci]"
    }
  },
  "version": "independent"
}
